<aside class="lvlup-filters" aria-label="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.label'}}">
  <div class="filter-group">
    <div class="eyebrow">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.level'}}</div>
    <div class="level-buttons">
      <button type="button" name="level-all" class="level-btn is-all" data-action="setLevel" data-level=""
        aria-pressed="{{#if allLevelsPressed}}true{{else}}false{{/if}}">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.all'}}</button>
      {{#each levelButtons}}
        <button type="button" name="level-{{level}}" class="level-btn" data-action="setLevel" data-level="{{level}}"
          aria-pressed="{{#if pressed}}true{{else}}false{{/if}}">{{level}}</button>
      {{/each}}
    </div>
    <details class="range" data-sync="range" {{#if rangeActive}}open{{/if}}>
      <summary>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.range'}}</summary>
      <div class="range-row">
        <input type="number" min="0" max="{{slot.level}}" data-filter="minLevel" value="{{filters.minLevel}}"
          placeholder="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.placeholder.minLevel'}}"
          aria-label="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.placeholder.minLevel'}}">
        <span aria-hidden="true">–</span>
        <input type="number" min="0" max="{{slot.level}}" data-filter="maxLevel" value="{{filters.maxLevel}}"
          placeholder="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.placeholder.maxLevel'}}"
          aria-label="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.placeholder.maxLevel'}}">
      </div>
    </details>
  </div>

  {{#if showSkillFilter}}
    <div class="filter-group">
      <div class="eyebrow">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.skills'}}</div>
      {{#each skills}}
        <label class="check-row">
          <input type="checkbox" data-filter="skill" value="{{slug}}" {{#if checked}}checked{{/if}}>
          <span class="check-label">{{label}}</span>
          <span class="check-count">{{count}}</span>
        </label>
      {{/each}}
      {{#if canToggleSkills}}
        <button type="button" name="skills-more" class="lvl-link" data-action="toggleAllSkills"
          aria-expanded="{{#if allSkills}}true{{else}}false{{/if}}">
          {{#if allSkills}}{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.fewerSkills'}}{{else}}{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.allSkills' count=skillTotal}}{{/if}}
        </button>
      {{/if}}
    </div>
  {{/if}}

  <div class="filter-group">
    <div class="eyebrow">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.rarity'}}</div>
    {{#each rarities}}
      <label class="check-row">
        <input type="checkbox" data-filter="rarity" value="{{key}}" {{#if checked}}checked{{/if}}>
        <span class="check-label">{{label}}</span>
      </label>
    {{/each}}
  </div>

  {{#if showDedicationSearch}}
    <div class="filter-group">
      <label class="eyebrow" for="{{partId}}-dedication">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.archetype'}}</label>
      <input id="{{partId}}-dedication" type="search" data-filter="dedicationSearch" value="{{filters.dedicationSearch}}"
        placeholder="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.placeholder.dedicationSearch'}}">
    </div>
  {{/if}}

  <div class="filter-foot">
    {{#if hiddenNote}}<p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.selector.hiddenNote'}}</p>{{/if}}
    <button type="button" name="reset" class="lvl-link" data-action="resetFilters">
      <i class="fa-solid fa-filter-circle-xmark" aria-hidden="true"></i> {{localize 'NEXT_LEVEL_UP_WIZARD.menu.filters.reset'}}
    </button>
  </div>
</aside>
