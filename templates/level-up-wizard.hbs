<div class="wizard-body">
  <header class="wizard-header">
    <h1>
      {{localize 'NEXT_LEVEL_UP_WIZARD.menu.header.name' actorName=actorName targetLevel=targetLevel}}
    </h1>
    <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.header.description'}}</p>
    {{#if levelJump}}
      <p class="notification warning">
        {{localize 'NEXT_LEVEL_UP_WIZARD.menu.header.levelJump' previousLevel=previousLevel targetLevel=targetLevel}}
      </p>
    {{/if}}
    {{#if classJournals.length}}
      <p class="class-journals">
        {{localize 'NEXT_LEVEL_UP_WIZARD.menu.notes.classJournal'}}
        {{#each classJournals}}
          <a class="content-link" draggable="true" data-link data-uuid="{{uuid}}" data-type="JournalEntryPage">
            <i class="fa-solid fa-book-open"></i>{{name}}
          </a>
        {{/each}}
      </p>
    {{/if}}
  </header>

  {{#if hasNothingToChoose}}
    <p class="nothing-to-choose">
      <i class="fa-solid fa-circle-info"></i>
      {{localize 'NEXT_LEVEL_UP_WIZARD.menu.nothingToChoose'}}
    </p>
  {{/if}}

  {{! Feats }}
  {{#if featSlots.length}}
    <fieldset class="wizard-section feats">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.feats.header'}}</legend>
      {{#each featSlots}}
        {{> lvlupFeatSlot}}
      {{/each}}
    </fieldset>
  {{/if}}

  {{#if missedSlots.length}}
    <fieldset class="wizard-section missed {{#if showMissed}}expanded{{/if}}">
      <legend>
        <button type="button" class="inline-control" data-action="toggleMissed">
          <i class="fa-solid {{#if showMissed}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
          {{localize 'NEXT_LEVEL_UP_WIZARD.menu.feats.missedHeader' count=missedSlots.length}}
        </button>
      </legend>
      {{#if showMissed}}
        <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.feats.missedHint'}}</p>
        {{#each missedSlots}}
          {{> lvlupFeatSlot}}
        {{/each}}
      {{/if}}
    </fieldset>
  {{/if}}

  {{! Skill increases }}
  {{#if skillIncreases.length}}
    <fieldset class="wizard-section skills">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.skillIncreases.header'}}</legend>
      <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.skillIncreases.hint' rank=maxSkillRankLabel}}</p>
      {{#each skillIncreases}}
        <div class="form-group">
          <label>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.skillIncreases.label'}}</label>
          <select data-choice="skillIncrease" data-index="{{index}}" name="lvlup-skillIncrease-{{index}}" class="{{#unless value}}empty{{/unless}}">
            <option value="">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.dropdown.placeholder'}}</option>
            {{#each options}}
              <option value="{{value}}" class="{{rankClass}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  {{! Attribute boosts }}
  {{#if manualAttributes}}
    <p class="notification info">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.manual'}}</p>
  {{/if}}
  {{#if boosts.sets.length}}
    <fieldset class="wizard-section boosts">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.header'}}</legend>
      {{#each boosts.sets}}
        <p class="hint">
          {{#if @root.gradualBoosts}}
            {{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.gradualLabel' count=remaining set=set}}
          {{else}}
            {{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.label' count=remaining}}
          {{/if}}
          <span class="counter {{#if complete}}complete{{/if}}">{{chosen}}/{{remaining}}</span>
        </p>
        <div class="attribute-grid">
          {{#each attributes}}
            <button type="button"
              class="attribute-boost {{#if selected}}selected{{/if}} {{#if partial}}partial{{/if}} {{#if locked}}locked{{/if}}"
              data-action="toggleBoost" data-set="{{../set}}" data-attribute="{{key}}"
              {{#if disabled}}disabled{{/if}}
              {{#if locked}}data-tooltip="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.alreadyBoosted'}}"{{/if}}
              {{#if partial}}data-tooltip="{{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.partialHint'}}"{{/if}}>
              <span class="attribute-name">{{label}}</span>
              <span class="boost-state">
                {{#if partial}}
                  {{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.partial'}}
                {{else}}
                  {{localize 'NEXT_LEVEL_UP_WIZARD.menu.attributeBoosts.boost'}}
                {{/if}}
              </span>
            </button>
          {{/each}}
        </div>
      {{/each}}
      <div class="attribute-grid modifiers">
        {{#each boosts.modifiers}}
          <div class="lvlup-modifier {{#if changed}}changed{{/if}}">
            {{display}}
          </div>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}

  {{! Intelligence bonus: one trained skill and one language per modifier increase }}
  {{#if intSkills.length}}
    <fieldset class="wizard-section int-bonus">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.intBonus.header'}}</legend>
      <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.intBonus.hint'}}</p>
      {{#each intSkills}}
        <div class="form-group">
          <label>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.intBonus.skill'}}</label>
          <select data-choice="intSkill" data-index="{{index}}" name="lvlup-intSkill-{{index}}" class="{{#unless value}}empty{{/unless}}">
            <option value="">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.dropdown.placeholder'}}</option>
            {{#each options}}
              <option value="{{value}}" class="{{rankClass}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  {{#if languages.length}}
    <fieldset class="wizard-section languages">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.languages.header'}}</legend>
      <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.languages.hint'}}</p>
      {{#each languages}}
        <div class="form-group">
          <label>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.languages.label'}}</label>
          <select data-choice="language" data-index="{{index}}" name="lvlup-language-{{index}}">
            <option value="">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.languages.later'}}</option>
            {{#each options}}
              <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  {{! Skill potency (automatic bonus progression) }}
  {{#if potency}}
    <fieldset class="wizard-section potency">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.skillPotency.header'}}</legend>
      {{#if potency.current.length}}
        <p class="hint">
          {{localize 'NEXT_LEVEL_UP_WIZARD.menu.skillPotency.current'}}
          {{#each potency.current}}<span class="tag">{{label}} +{{potency}}</span>{{/each}}
        </p>
      {{/if}}
      {{#each potency.selects}}
        <div class="form-group">
          <label>{{label}}</label>
          <select data-choice="potency" data-index="{{key}}" name="lvlup-potency-{{key}}" class="{{#unless value}}empty{{/unless}}">
            <option value="">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.dropdown.placeholder'}}</option>
            {{#each options}}
              <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  {{! Class features gained }}
  {{#if classFeatures.length}}
    <fieldset class="wizard-section features">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.features.class.header'}}</legend>
      <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.features.class.hint'}}</p>
      {{#each classFeatures}}
        <details class="class-feature" data-sync="feature-{{@index}}">
          <summary>
            <img src="{{img}}" alt="" loading="lazy">
            <a class="content-link" draggable="true" data-link data-uuid="{{uuid}}" data-type="Item">{{name}}</a>
            <span class="feature-level">{{level}}</span>
          </summary>
          <div class="feature-description">{{{description}}}</div>
        </details>
      {{/each}}
    </fieldset>
  {{/if}}

  {{! Spellcasting reminders }}
  {{#if spellcasting}}
    <fieldset class="wizard-section spellcasting">
      <legend>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.features.spellcasting.header'}}</legend>
      {{#if spellcasting.newRank}}
        <p><strong>{{localize 'NEXT_LEVEL_UP_WIZARD.menu.features.spellcasting.rank' rank=spellcasting.newRank}}</strong></p>
      {{/if}}
      {{#if spellcasting.entries.length}}
        <p class="hint">{{localize 'NEXT_LEVEL_UP_WIZARD.menu.features.spellcasting.slots'}}</p>
        <ul class="spellcasting-entries">
          {{#each spellcasting.entries}}
            <li>{{name}} <span class="tag">{{type}}</span></li>
          {{/each}}
        </ul>
      {{/if}}
    </fieldset>
  {{/if}}
</div>
