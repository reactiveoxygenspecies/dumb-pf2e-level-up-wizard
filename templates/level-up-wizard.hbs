<div class="wizard-body {{#if stepped}}is-stepped{{else}}is-single{{/if}}{{#if reviewing}} is-review{{/if}}">
  {{#if stepped}}
    <nav class="wizard-steps" aria-label="{{localize 'DUMB_LEVEL_UP_WIZARD.menu.steps.label' level=targetLevel}}">
      {{#each steps}}
        <button type="button" name="step-{{key}}" class="step{{#if current}} is-current{{/if}}{{#if done}} is-done{{/if}}"
          data-action="goStep" data-step="{{key}}"{{#if current}} aria-current="step"{{/if}}{{#if blocked}} aria-disabled="true"{{/if}}>
          <span class="step-mark" aria-hidden="true">{{#if done}}<i class="fa-solid fa-check"></i>{{/if}}</span>
          <span class="step-label">{{label}}</span>
          {{#if count}}<span class="step-count">{{count}}</span>{{/if}}
          {{#if optional}}<span class="step-note">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.steps.optional'}}</span>{{/if}}
          {{#if done}}<span class="sr-only">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.steps.complete'}}</span>{{/if}}
        </button>
      {{/each}}
    </nav>
  {{/if}}

  <div class="wizard-split">
    {{#if showRail}}
      {{> "modules/dumb-pf2e-level-up-wizard/templates/partials/wizard-rail.hbs" rail}}
    {{/if}}

    <div class="wizard-main" tabindex="-1">
      {{#if reviewing}}
        {{> "modules/dumb-pf2e-level-up-wizard/templates/partials/wizard-review.hbs" review actorName=actorName targetLevel=targetLevel}}
      {{else}}
        {{#unless stepped}}
          <header class="main-head">
            <h1>{{title}}</h1>
            <p class="lead">{{subtitle}}</p>
          </header>
        {{/unless}}

        {{#if levelJump}}
          <p class="notice warning">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            {{localize 'DUMB_LEVEL_UP_WIZARD.menu.header.levelJump' previousLevel=previousLevel targetLevel=targetLevel}}
          </p>
        {{/if}}

        {{! Feats }}
        {{#if show.feats}}
          <section class="choice-block feats" aria-label="{{localize 'DUMB_LEVEL_UP_WIZARD.menu.feats.header'}}">
            {{#if stepped}}
              <h2 class="block-title">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.feats.title' level=targetLevel}}</h2>
            {{/if}}
            {{#each featSlots}}
              {{> lvlupFeatSlot}}
            {{/each}}
            {{#if missedSlots.length}}
              <button type="button" name="toggle-missed" class="optional-toggle" data-action="toggleMissed"
                aria-expanded="{{#if showMissed}}true{{else}}false{{/if}}">
                <i class="fa-solid {{#if showMissed}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i>
                <span>
                  <strong>{{localize 'DUMB_LEVEL_UP_WIZARD.menu.feats.optional'}}</strong>
                  · {{localize 'DUMB_LEVEL_UP_WIZARD.menu.feats.optionalRow' count=missedCount}}
                  <span class="muted">({{missedList}})</span>
                </span>
              </button>
              {{#if showMissed}}
                <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.feats.missedHint'}}</p>
                {{#each missedSlots}}
                  {{> lvlupFeatSlot}}
                {{/each}}
              {{/if}}
            {{/if}}
          </section>
        {{/if}}

        {{! Skill increases }}
        {{#if show.skills}}
          <section class="choice-block skills">
            {{#each skillIncreases}}
              <div class="choice-card" role="group" aria-labelledby="skill-h-{{index}}">
                <div class="card-head">
                  <h2 id="skill-h-{{index}}">{{title}}</h2>
                  <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.skillIncreases.hint' rank=@root.maxSkillRankLabel}}</p>
                </div>
                {{> "modules/dumb-pf2e-level-up-wizard/templates/partials/wizard-skill-grid.hbs" grid}}
              </div>
            {{/each}}
          </section>
        {{/if}}

        {{! Attribute boosts }}
        {{#if show.boosts}}
          <section class="choice-block boosts">
            {{#each boostSets}}
              <div class="boost-set" role="group" aria-labelledby="boost-h-{{set}}">
                <div class="set-head">
                  <h2 id="boost-h-{{set}}">{{title}}</h2>
                  <span class="counter{{#if complete}} is-complete{{/if}}">{{chosen}}/{{remaining}}</span>
                </div>
                <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.attributeBoosts.halfRule'}}</p>
                <div class="boost-grid">
                  {{#each tiles}}
                    <button type="button" name="boost-{{../set}}-{{key}}" class="boost-tile is-{{status}}"
                      data-action="toggleBoost" data-set="{{../set}}" data-attribute="{{key}}"
                      aria-pressed="{{#if pressed}}true{{else}}false{{/if}}"{{#if disabled}} disabled{{/if}}>
                      <span class="tile-name">{{label}}</span>
                      <span class="tile-value">{{display}}</span>
                      <span class="tile-line">
                        {{#if half}}
                          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.4"></circle><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path></svg>
                        {{/if}}
                        {{line}}
                      </span>
                    </button>
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </section>
        {{/if}}

        {{! Intelligence skill, languages, skill potency }}
        {{#if show.extras}}
          {{#if intSkills.length}}
            <section class="choice-card int-bonus" aria-labelledby="int-h">
              <div class="card-head">
                <h2 id="int-h">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.intBonus.header'}}</h2>
                <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.intBonus.hint'}}</p>
              </div>
              {{#each intSkills}}
                {{> "modules/dumb-pf2e-level-up-wizard/templates/partials/wizard-skill-grid.hbs" grid}}
              {{/each}}
            </section>
          {{/if}}

          {{#if languages}}
            <section class="choice-card languages" aria-labelledby="lang-h">
              <div class="card-head">
                <h2 id="lang-h">{{languages.title}}</h2>
                {{#if languages.showCounter}}<span class="counter{{#if languages.complete}} is-complete{{/if}}">{{languages.chosenCount}}/{{languages.count}}</span>{{/if}}
                <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.languages.hint'}}</p>
              </div>
              <div class="chip-row" role="group" aria-labelledby="lang-h">
                {{#each languages.chips}}
                  <button type="button" name="lang-{{slug}}" class="lvl-toggle{{#if selected}} is-selected{{/if}}"
                    data-action="toggleLanguage" data-value="{{slug}}"
                    aria-pressed="{{#if selected}}true{{else}}false{{/if}}"{{#if disabled}} disabled{{/if}}>
                    {{label}}{{#if rarity}} <small>({{rarity}})</small>{{/if}}
                  </button>
                {{/each}}
                {{#if languages.canToggle}}
                  <button type="button" name="lang-more" class="lvl-link" data-action="toggleAllLanguages"
                    aria-expanded="{{#if languages.expanded}}true{{else}}false{{/if}}">
                    {{#if languages.expanded}}{{localize 'DUMB_LEVEL_UP_WIZARD.menu.languages.fewer'}}{{else}}{{localize 'DUMB_LEVEL_UP_WIZARD.menu.languages.more'}}{{/if}}
                  </button>
                {{/if}}
                <button type="button" name="lang-later" class="lvl-link quiet" data-action="clearLanguages"
                  aria-pressed="{{#if languages.later}}true{{else}}false{{/if}}">
                  {{localize 'DUMB_LEVEL_UP_WIZARD.menu.languages.later'}}
                </button>
              </div>
            </section>
          {{/if}}

          {{#if potency}}
            <section class="choice-card potency" aria-labelledby="potency-h">
              <div class="card-head">
                <h2 id="potency-h">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.skillPotency.header'}}</h2>
                {{#if potency.current.length}}
                  <p class="hint">
                    {{localize 'DUMB_LEVEL_UP_WIZARD.menu.skillPotency.current'}}
                    {{#each potency.current}}<span class="tag">{{label}} +{{potency}}</span>{{/each}}
                  </p>
                {{/if}}
              </div>
              {{#each potency.selects}}
                <h3 class="grid-title">{{label}}</h3>
                {{> "modules/dumb-pf2e-level-up-wizard/templates/partials/wizard-skill-grid.hbs" grid}}
              {{/each}}
            </section>
          {{/if}}
        {{/if}}

        {{! Spells: slot changes and new spells for the class spellcasting entry }}
        {{#if show.spells}}
          <section class="choice-block spells" aria-labelledby="spells-h">
            <h2 id="spells-h" class="block-title">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.header'}}</h2>
            {{#if spells.setup}}
              <div class="panel inline">
                <span>{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.setupHint' className=spells.className}}</span>
                <button type="button" name="spell-setup" class="lvl-toggle{{#if spells.active}} is-selected{{/if}}" data-action="toggleSpellSetup"
                  aria-pressed="{{#if spells.active}}true{{else}}false{{/if}}">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.setup'}}</button>
              </div>
            {{else}}
              <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.managed' entry=spells.entryName}}</p>
            {{/if}}
            {{#if spells.active}}
              {{#if spells.needTradition}}
                <label class="form-row">
                  <span>{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.tradition'}}</span>
                  <select data-spell-tradition name="spell-tradition">
                    <option value="">{{localize 'DUMB_LEVEL_UP_WIZARD.builder.spells.chooseTradition'}}</option>
                    {{#each spells.traditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
              {{/if}}
              {{#if spells.slotChanges.length}}
                <div class="lvl-spell-slots" aria-label="{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.slots'}}">
                  {{#each spells.slotChanges}}<span class="lvl-spell-slot">{{label}}: {{from}} → <strong>{{to}}</strong></span>{{/each}}
                </div>
              {{/if}}
              {{#if spells.noPicks}}<p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.noPicks'}}</p>{{/if}}
              {{#with spells}}{{#if groups.length}}{{> lvlupSpellPicker spellGroups=groups}}{{/if}}{{/with}}
              {{#if spells.signature}}
                <div class="lvl-signature">
                  <h3>{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.signatureHeader'}}</h3>
                  {{#if spells.signature.all}}
                    <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.signatureAll'}}</p>
                  {{else}}
                    <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.signatureHint'}}</p>
                    {{#each spells.signature.rows}}
                      <label class="form-row{{#if missing}} missing{{/if}}">
                        <span>{{label}}</span>
                        <select data-signature-rank="{{rank}}" name="signature-{{rank}}">
                          <option value="">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.spells.signatureChoose'}}</option>
                          {{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                        </select>
                      </label>
                    {{/each}}
                  {{/if}}
                </div>
              {{/if}}
            {{/if}}
          </section>
        {{/if}}

        {{! Class features gained and reminders: only on the single page, the steps put them in the review }}
        {{#unless stepped}}
          {{#if classFeatures.length}}
            <section class="choice-block features" aria-labelledby="features-h">
              <h2 id="features-h" class="block-title small">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.features.class.header'}}</h2>
              <p class="hint">{{localize 'DUMB_LEVEL_UP_WIZARD.menu.features.class.hint'}}</p>
              {{#each classFeatures}}
                <details class="class-feature" data-sync="feature-{{@index}}">
                  <summary>
                    <img src="{{img}}" alt="" loading="lazy">
                    <a class="content-link" draggable="true" data-link data-uuid="{{uuid}}" data-type="Item">{{name}}</a>
                    <span class="feature-level">{{localize 'DUMB_LEVEL_UP_WIZARD.selector.level' level=level}}</span>
                  </summary>
                  <div class="feature-description">{{{description}}}</div>
                </details>
              {{/each}}
            </section>
          {{/if}}

          {{#if manual.empty}}
            <div class="panel good inline">
              <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
              <span>{{localize 'DUMB_LEVEL_UP_WIZARD.menu.features.nothingByHand' level=targetLevel}}</span>
            </div>
          {{else}}
            <div class="panel warn">
              <div class="panel-title">
                <i class="fa-solid fa-hand-point-right" aria-hidden="true"></i>
                {{localize 'DUMB_LEVEL_UP_WIZARD.menu.features.byHand'}}
              </div>
              <ul>{{#each manual.items}}<li>{{this}}</li>{{/each}}</ul>
            </div>
          {{/if}}
        {{/unless}}

        {{#if classJournals.length}}
          <p class="class-journals">
            {{localize 'DUMB_LEVEL_UP_WIZARD.menu.notes.classJournal'}}
            {{#each classJournals}}
              <a class="content-link" draggable="true" data-link data-uuid="{{uuid}}" data-type="JournalEntryPage">
                <i class="fa-solid fa-book-open" aria-hidden="true"></i>{{name}}
              </a>
            {{/each}}
          </p>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
