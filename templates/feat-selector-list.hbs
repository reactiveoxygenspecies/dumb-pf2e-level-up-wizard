<section class="feat-results" aria-label="{{localize 'NEXT_LEVEL_UP_WIZARD.selector.listLabel'}}">
  <div class="result-count" role="status">
    {{localize 'NEXT_LEVEL_UP_WIZARD.selector.count' count=count total=total}}
    {{#if unmetShown}} · {{localize 'NEXT_LEVEL_UP_WIZARD.selector.unmetShown'}}{{/if}}
  </div>
  <ol class="lvlup-feat-list">
    {{#each groups}}
      {{#if level}}
        <li class="level-head"><h3>{{localize 'NEXT_LEVEL_UP_WIZARD.selector.level' level=level}}</h3></li>
      {{/if}}
      {{#each feats}}
        <li class="feat-row{{#if highlighted}} highlighted{{/if}}{{#if takenElsewhere}} taken{{/if}}{{#if unmet}} is-unmet{{/if}}">
          <button type="button" class="feat-row-btn" data-action="highlight" data-uuid="{{uuid}}"{{#if highlighted}} aria-current="true"{{/if}}>
            <span class="feat-name">
              <span class="name-line">
                <span class="name">{{name}}</span>
                {{#if glyph}}<span class="lvl-glyph" role="img" aria-label="{{glyph.label}}">{{glyph.char}}</span>{{/if}}
                {{#if rarityLabel}}<span class="lvl-chip rarity {{rarity}}">{{rarityLabel}}</span>{{/if}}
                {{#if isDedication}}<span class="lvl-chip archetype">{{localize 'PF2E.TraitDedication'}}</span>
                {{else if isArchetype}}<span class="lvl-chip archetype">{{localize 'PF2E.TraitArchetype'}}</span>{{/if}}
                {{#if takenElsewhere}}<span class="lvl-chip taken">{{localize 'NEXT_LEVEL_UP_WIZARD.selector.takenElsewhere'}}</span>{{/if}}
              </span>
              {{#if subtitle}}<span class="subtitle">{{subtitle}}</span>{{/if}}
            </span>
            {{#if pill}}
              <span class="lvl-pill status-{{pill.status}}" data-tooltip="{{pillTooltip}}">
                <i class="fa-solid {{pill.icon}}" aria-hidden="true"></i>
                <span class="pill-text">{{pill.text}}</span>
              </span>
            {{/if}}
          </button>
        </li>
      {{/each}}
    {{else}}
      <li class="no-results">{{localize 'NEXT_LEVEL_UP_WIZARD.selector.noResults'}}</li>
    {{/each}}
  </ol>
</section>
