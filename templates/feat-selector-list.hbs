<section class="feat-results">
  <div class="result-count">
    {{localize 'PF2E_LEVEL_UP_WIZARD.selector.count' count=count total=total}}
  </div>
  <ol class="feat-list">
    {{#each feats}}
      <li class="feat-row {{#if highlighted}}highlighted{{/if}} {{#if takenElsewhere}}taken{{/if}} {{#if prereq}}prereq-{{prereq.status}}{{/if}}"
        data-uuid="{{uuid}}" data-action="highlight">
        <button type="button" class="feat-image" data-action="sendToChat"
          data-tooltip="{{localize 'PF2E_LEVEL_UP_WIZARD.menu.tooltips.sendToChat'}}"
          aria-label="{{localize 'PF2E_LEVEL_UP_WIZARD.menu.tooltips.sendToChat'}}">
          <img src="{{img}}" alt="" loading="lazy">
          <i class="fa-solid fa-comment"></i>
        </button>
        <div class="feat-name">
          <span class="name">{{name}}</span>
          <span class="tags">
            {{#if rarityLabel}}<span class="tag rarity {{rarity}}">{{rarityLabel}}</span>{{/if}}
            {{#if isDedication}}<span class="tag archetype">{{localize 'PF2E.TraitDedication'}}</span>
            {{else if isArchetype}}<span class="tag archetype">{{localize 'PF2E.TraitArchetype'}}</span>{{/if}}
            {{#if takenElsewhere}}<span class="tag taken">{{localize 'PF2E_LEVEL_UP_WIZARD.selector.takenElsewhere'}}</span>{{/if}}
          </span>
        </div>
        {{#if prereqIcon}}
          <i class="prereq {{prereq.status}} {{prereqIcon}}" data-tooltip="{{prereqTooltip}}"></i>
        {{else if prerequisites.length}}
          <i class="prereq unknown fa-solid fa-asterisk" data-tooltip="{{prereqTooltip}}"></i>
        {{/if}}
        <span class="feat-level">{{effectiveLevel}}</span>
        <button type="button" class="select-feat icon fa-solid fa-check" data-action="select"
          {{#if takenElsewhere}}disabled{{/if}}
          data-tooltip="{{localize 'PF2E_LEVEL_UP_WIZARD.menu.tooltips.selectFeat'}}"
          aria-label="{{localize 'PF2E_LEVEL_UP_WIZARD.menu.tooltips.selectFeat'}}"></button>
      </li>
    {{else}}
      <li class="no-results">{{localize 'PF2E_LEVEL_UP_WIZARD.selector.noResults'}}</li>
    {{/each}}
  </ol>
</section>
