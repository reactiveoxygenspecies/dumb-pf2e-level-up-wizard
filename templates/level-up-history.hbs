<section class="history-list">
  {{#if entries.length}}
    <ol class="timeline">
      {{#each entries}}
        <li class="timeline-entry{{#if isLatest}} is-latest{{/if}}">
          <div class="rail">
            <span class="level-badge" aria-hidden="true">{{level}}</span>
            <span class="rail-line" aria-hidden="true"></span>
          </div>
          <div class="entry-body">
            <div class="entry-head">
              <h3>{{heading}}</h3>
              <time title="{{fullDate}}">{{date}}</time>
            </div>
            {{#if items.length}}
              <ul class="summary">
                {{#each items}}
                  <li>
                    {{#if uuid}}<a class="content-link" data-link data-uuid="{{uuid}}" data-type="Item" data-tooltip="{{title}}">{{label}}</a>{{else}}{{label}}{{/if}}
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="summary muted">{{localize 'NEXT_LEVEL_UP_WIZARD.messages.global.noChoices'}}</p>
            {{/if}}
            <p class="by">{{localize 'NEXT_LEVEL_UP_WIZARD.history.by' user=user}}</p>
            {{#if canUndo}}
              <button type="button" name="undo" class="lvl-btn undo" data-action="undo">
                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                {{localize 'NEXT_LEVEL_UP_WIZARD.history.undoThis'}}
              </button>
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="empty">{{localize 'NEXT_LEVEL_UP_WIZARD.history.empty'}}</p>
  {{/if}}
</section>
