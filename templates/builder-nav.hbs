<nav class="lvlb-nav" aria-label="{{localize 'DUMB_LEVEL_UP_WIZARD.builder.stepsLabel'}}">
  {{#each nav}}
    {{#unless @first}}<span class="lvlb-nav-line" aria-hidden="true"></span>{{/unless}}
    <button type="button" class="lvlb-nav-step {{#if current}}current{{/if}} {{#if complete}}complete{{/if}}"
      data-action="goto" data-step="{{id}}" {{#if current}}aria-current="step"{{/if}}>
      <span class="lvlb-nav-dot" aria-hidden="true">
        {{#if complete}}<i class="fa-solid fa-check"></i>{{else}}{{number}}{{/if}}
      </span>
      <span class="lvlb-nav-label">{{label}}</span>
    </button>
  {{/each}}
</nav>
